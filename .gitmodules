	path = opensim_docker
	url = https://github.com/opensimrt-ros/opensim_docker.git
	pushurl = git@github.com:opensimrt-ros/opensim_docker.git
[submodule "vim"]
	path = vim
	url = git@github.com:fbkl/vim.git
[submodule "catkin_ws/src/opensimrt_msgs"]
	path = catkin_ws/src/opensimrt_msgs
	url = https://github.com/opensimrt-ros/opensimrt_msgs.git
[submodule "catkin_ws/src/opensimrt_bridge"]
	path = catkin_ws/src/opensimrt_bridge
	url = https://github.com/fbkl/opensimrt_bridge.git
	pushurl = git@github.com:fbkl/opensimrt_bridge.git
[submodule "catkin_ws/src/opensimrt_core"]
